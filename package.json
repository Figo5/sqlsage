{
  "name": "sqlsage",
  "version": "0.2.1",
  "type": "module",
  "description": "Correctness-first PostgreSQL query explainer and optimizer CLI",
  "license": "MIT",
  "author": "Figo5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Figo5/sqlsage.git"
  },
  "homepage": "https://github.com/Figo5/sqlsage#readme",
  "bugs": {
    "url": "https://github.com/Figo5/sqlsage/issues"
  },
  "keywords": [
    "postgresql",
    "sql",
    "query-optimizer",
    "explain",
    "database",
    "cli"
  ],
  "bin": {
    "sqlsage": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "corpus/catalog.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "esbuild src/cli.ts src/index.ts --bundle --platform=node --packages=external --format=esm --target=node22 --outdir=dist",
    "prepack": "npm run build",
    "sqlsage": "node src/cli.ts",
    "explain": "node src/cli.ts",
    "eval": "node eval/run.ts",
    "groundtruth": "node eval/collect-groundtruth.ts",
    "test": "node --test src/*.test.ts src/**/*.test.ts",
    "test:install": "node eval/install-smoke.ts",
    "validate": "node eval/validate-predictions.ts",
    "check": "npm test && npm run typecheck && node eval/dump-ir.ts --check && node eval/run.ts && npm run validate && npm run build && npm run test:install",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "pgsql-ast-parser": "^12.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "esbuild": "0.28.1",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
